<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MarketFinderPro</AssemblyName>
    <RootNamespace>MarketFinderPro</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>Market Finder Pro</Product>
    <Company>Marco Consiglio · marcocreazioni.it</Company>
    <Copyright>© 2026 Marco Consiglio</Copyright>
    <Version>1.0.0</Version>
    <!-- Avviso noto del pacchetto WebView2 (riferimento WPF non usato): innocuo per WinForms -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <!-- I file del corso (HTML/CSS/JS) vengono incorporati nell'EXE:
       il nome logico della risorsa è il percorso relativo, es. "wwwroot/assets/app.js" -->
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>
</Project>

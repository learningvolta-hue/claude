<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Permette di compilare anche da Linux/macOS (es. per verifiche automatiche) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>AnalisiImmobiliare.App</RootNamespace>
    <AssemblyName>AnalisiImmobiliare</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Authors>Marco Consiglio</Authors>
    <Company>Marco Consiglio</Company>
    <Product>Analisi Investimenti Immobiliari</Product>
    <Copyright>© 2026 Marco Consiglio</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AnalisiImmobiliare.Core\AnalisiImmobiliare.Core.csproj" />
  </ItemGroup>

</Project>
